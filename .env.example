# Copy this file to a local environment file such as .env.local and replace the
# placeholders with the values from your Supabase project.
# This file is safe to commit because it contains only examples.

# Database
# Runtime connection used by Prisma and the application server.
# Create this in Supabase: Project settings > Database > Connection string.
# Use the pooled connection for app traffic.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.wdbejyhjiufwtoufmxwn.supabase.co:5432/postgres"
# Optional direct connection for local migration workflows.
# Only add this in your local env if your Supabase workflow requires a non-pooled
# connection string for Prisma migrations.
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Authentication
# Generate secure random values with: openssl rand -hex 32
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET"

# Reservation holds
# Default temporary hold duration in minutes. Can also be overridden per request.
RESERVATION_HOLD_DURATION_MINUTES="10"
